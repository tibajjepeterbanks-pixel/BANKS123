# Database Configuration
# For development with SQLite:
# DATABASE_URL="file:./dev.db"

# For PostgreSQL:
DATABASE_URL="postgresql://user:password@localhost:5432/unipast_db"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# File Upload
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE=10485760

# Payment API Configuration (Future)
PAYMENT_API_KEY="your-payment-api-key"
PAYMENT_API_URL="https://api.payment-provider.com"
PAYMENT_WEBHOOK_SECRET="your-webhook-secret"

# Email Configuration (Optional)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="noreply@unipast.ac.ug"

# AWS S3 Configuration (Production)
AWS_ACCESS_KEY_ID="your-aws-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret"
AWS_S3_BUCKET="unipast-papers"
AWS_REGION="us-east-1"

# Analytics
NEXT_PUBLIC_ANALYTICS_ID=""

# Environment
NODE_ENV="development"
